    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Lvoq Stream uses the local network to find cameras, directors, and Lvoq Show, to send low-latency video, and to run the team intercom." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Lvoq Stream usa la red local para encontrar cámaras, directores y Lvoq Show, transmitir video con baja latencia y usar el intercom del equipo." } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "O Lvoq Stream usa a rede local para encontrar câmeras, diretores e o Lvoq Show, transmitir vídeo com baixa latência e usar o intercom da equipe." } }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Lvoq Stream uses the microphone for the team intercom and the live audio sent to the director." } },
